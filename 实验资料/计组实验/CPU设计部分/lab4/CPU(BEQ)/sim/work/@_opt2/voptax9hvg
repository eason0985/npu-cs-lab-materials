library verilog;
use verilog.vl_types.all;
entity blockage is
    port(
        pc_write        : out    vl_logic;
        if_id_write     : out    vl_logic;
        id_exe_flush    : out    vl_logic;
        if_id_flush     : out    vl_logic;
        instruction_id  : in     vl_logic_vector(31 downto 0);
        instruction_exe : in     vl_logic_vector(31 downto 0);
        zero            : in     vl_logic
    );
end blockage;
